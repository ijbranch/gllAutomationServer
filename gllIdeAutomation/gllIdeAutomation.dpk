package gllIdeAutomation;

{$R *.res}
{$DESCRIPTION 'IDE Automation (gated by GITLAK_IDE_AUTOMATION=1)'}
// No CompilerVersion guard here: in a package source the System unit is not loaded yet, so
// CompilerVersion is undeclared and EVERY comparison on it is true (measured 2026-10-13: ">= 37",
// ">= 36" and "< 37" all fired). The Delphi 13 floor is enforced by the units' guards instead.
{$LIBSUFFIX AUTO}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  designide,
  gllAutomationServer;

contains
  gllIdeAutomation.Starter in 'src\gllIdeAutomation.Starter.pas',
  gllIdeAutomation.TreeText in 'src\gllIdeAutomation.TreeText.pas',
  gllIdeAutomation.Rules in 'src\gllIdeAutomation.Rules.pas',
  gllIdeAutomation.IdeCommands in 'src\gllIdeAutomation.IdeCommands.pas';

end.
